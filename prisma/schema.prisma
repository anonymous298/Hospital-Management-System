// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id  String  @id @default(cuid())
  clerkId String  @unique

  username  String  @unique
  email String  @unique
  name  String?
  imageUrl  String?

  role  UserRole  @default(PATIENT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payments  Payment[]
  doctorAppointments DoctorAppointment[]

}

model Doctor {
  id  String  @id @default(cuid())

  name String
  specialization String
  qualification String
  location  String
  success String
  experience  String
  patients  String
  about String
  consultationFee Int
  imageUrl String?

  availability  DoctorAvailabilityStatus  @default(AVAILABLE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doctorAvailabilityDates  DoctorAvailabilityDate[]
  doctorAppointments  DoctorAppointment[]
  payments  Payment[]

}

model DoctorAvailabilityDate {
  id  String  @id @default(cuid())
  doctorId  String

  date DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  doctorTimeSlots DoctorTimeSlot[]
}

model DoctorTimeSlot {
  id  String  @id @default(cuid())
  availabilityDateId  String

  startTime String       // could be "10:00"
  endTime String         // could be "10:30"

  isBooked  Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  availabilityDate  DoctorAvailabilityDate  @relation(fields: [availabilityDateId], references: [id],  onDelete: Cascade)

  doctorAppointment DoctorAppointment?  @relation("TimeSlotAppointment")  // renaming

}

model DoctorAppointment {
  id  String  @id @default(cuid())
  userId  String
  doctorId  String
  timeSlotId  String  @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  timeSlot  DoctorTimeSlot  @relation("TimeSlotAppointment", fields: [timeSlotId], references: [id], onDelete: Cascade)

  patientDetail PatientDetail?
  payment Payment?

}

model PatientDetail {
  id  String  @id @default(cuid())
  doctorAppointmentId String  @unique
  
  fullName  String
  age Int
  phoneNumber String 
  gender  GenderRole
  email String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doctorAppointment DoctorAppointment @relation(fields: [doctorAppointmentId], references: [id], onDelete: Cascade)

}

model Payment {
  id  String  @id @default(cuid())
  userId  String
  doctorId  String
  doctorAppointmentId String  @unique

  amount Int
  status    PaymentStatus
  method    PaymentMethod

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  doctorAppointment DoctorAppointment @relation(fields: [doctorAppointmentId], references: [id])
  
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum DoctorAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

enum GenderRole {
  MALE
  FEMALE
  OTHER
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}